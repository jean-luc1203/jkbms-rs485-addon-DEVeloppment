#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: Node-RED
# Configure Node-RED avant exécution
# ==============================================================================

# Install the versioned SCADA interface and image assets into HAOS /local.
# Keep this independent of the persistent Node-RED userDir and never delete
# unrelated files or directories under /config/www.
SCADA_SOURCE="/etc/smartphoton_jkbms_multipack/www"
SCADA_TARGET="/config/www/smartphoton_jkbms_multipack"
SCADA_FILES=(
    "scada/index.html"
    "assets/bms-default.webp"
    "assets/pack-default.webp"
)
SCADA_READY=true
for relative_path in "${SCADA_FILES[@]}"; do
    if [[ ! -f "${SCADA_SOURCE}/${relative_path}" ]]; then
        SCADA_READY=false
        bashio::log.warning "SCADA packaged asset missing: ${relative_path}"
    fi
done

if [[ "${SCADA_READY}" == true ]]; then
    mkdir -p "${SCADA_TARGET}/scada" "${SCADA_TARGET}/assets" \
        || bashio::exit.nok "Failed to create SCADA /config/www directories"
    for relative_path in "${SCADA_FILES[@]}"; do
        source_file="${SCADA_SOURCE}/${relative_path}"
        target_file="${SCADA_TARGET}/${relative_path}"
        if ! cmp -s "${source_file}" "${target_file}"; then
            cp -f "${source_file}" "${target_file}.tmp" \
                || bashio::exit.nok "Failed to stage SCADA asset: ${relative_path}"
            chmod 0644 "${target_file}.tmp" \
                || bashio::exit.nok "Failed to chmod SCADA asset: ${relative_path}"
            mv -f "${target_file}.tmp" "${target_file}" \
                || bashio::exit.nok "Failed to install SCADA asset: ${relative_path}"
        fi
    done
    bashio::log.info "SmartPhoton SCADA web assets available under /local/smartphoton_jkbms_multipack/"
else
    # Monitoring must remain operational even if optional SCADA files are absent.
    bashio::log.warning "SCADA assets are incomplete in this add-on image; /local SCADA may return 404."
fi

# Assure que la configuration existe
if ! bashio::fs.directory_exists '/config/smartphoton_jkbms_multipack/'; then
    mkdir -p /config/smartphoton_jkbms_multipack/nodes \
        || bashio::exit.nok "Failed to create node-red configuration directory"

    # Copie les fichiers modèles
    cp /etc/node-red/flows.json /config/smartphoton_jkbms_multipack/
    cp /etc/node-red/settings.js /config/smartphoton_jkbms_multipack/

    # Création d'un ID de flow aléatoire
    id=$(node -e "console.log((1+Math.random()*4294967295).toString(16));")
    sed -i "s/%%ID%%/${id}/" "/config/smartphoton_jkbms_multipack/flows.json"
fi

# Vérification de version
if ! bashio::fs.file_exists '/config/smartphoton_jkbms_multipack/version'; then
    touch /config/smartphoton_jkbms_multipack/version
    VERSION=$(bashio::addon.version)
    bashio::log.info "Module Addon Version number: ${VERSION}"
    echo $VERSION >> /config/smartphoton_jkbms_multipack/version
    chmod 775 /config/smartphoton_jkbms_multipack/version
    bashio::log.info "${VERSION}"
else
    VERSIONOLD=$(cat /config/smartphoton_jkbms_multipack/version)
    VERSION=$(bashio::addon.version)
    if [ $VERSIONOLD != $VERSION ]; then
        bashio::log.info "Mise a jour de la nouvelle version"
        bashio::log.info "Module Addon Version number: ${VERSION}"
        if bashio::fs.file_exists '/config/smartphoton_jkbms_multipack/flows.backup'; then
            rm /config/smartphoton_jkbms_multipack/flows.backup
        fi
        mv /config/smartphoton_jkbms_multipack/flows.json /config/smartphoton_jkbms_multipack/flows.backup
        cp /etc/node-red/flows.json /config/smartphoton_jkbms_multipack/
    fi
fi

# Remplace le fichier flows par celui d'origine
if bashio::fs.file_exists '/config/smartphoton_jkbms_multipack/flows.backup'; then
    rm /config/smartphoton_jkbms_multipack/flows.backup
fi
mv /config/smartphoton_jkbms_multipack/flows.json /config/smartphoton_jkbms_multipack/flows.backup
cp /etc/node-red/flows.json /config/smartphoton_jkbms_multipack/

# Désinstallation des packages Node-RED conflictuels
cd /config || bashio::exit.nok "Could not change directory to Node-RED"
if bashio::fs.file_exists "/config/package.json"; then
    npm uninstall \
        node-red-contrib-home-assistant \
        node-red-contrib-home-assistant-llat \
        node-red-contrib-home-assistant-ws \
        || bashio::log.warning "Failed un-installing conflicting packages"
fi
